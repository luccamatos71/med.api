# ─── Supabase (banco de dados) ───────────────────────────────────────────────
# Supabase > Settings > Database > Connection string > URI
# Trocar "postgres://" por "postgresql+asyncpg://"
DATABASE_URL=postgresql+asyncpg://postgres:[senha]@db.[project-ref].supabase.co:5432/postgres

# ─── Upstash (Redis para fila de jobs) ───────────────────────────────────────
# upstash.com > New Database > Redis > .NET / Python SDK > copiar URL "rediss://"
REDIS_URL=rediss://default:[senha]@[host].upstash.io:6379

# ─── Supabase Storage (S3-compatible — armazenar PDFs) ───────────────────────
# Supabase > Storage > S3 Connection > Enable > Generate credentials
STORAGE_ENDPOINT_URL=https://[project-ref].supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY_ID=<gerado no painel Supabase Storage>
STORAGE_SECRET_ACCESS_KEY=<gerado no painel Supabase Storage>
STORAGE_BUCKET_NAME=med-materials

# ─── Auth (compartilhado med-api ↔ med-web) ──────────────────────────────────
NEXTAUTH_SECRET=<gerar com: openssl rand -base64 32>

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Observabilidade ─────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ─── Ambiente ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
